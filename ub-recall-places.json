      "book": "\\b(Mexico|Central America)\\b"
    },
    {
      "id": "south-america",
      "article": "\\b(South America\\w*|Peru\\w*|Andes|Andean|Incas?|Tiahuanaco|Tiwanaku|Chile\\w*|Monte Verde|Amazon\\w*|Viracocha)\\b",
